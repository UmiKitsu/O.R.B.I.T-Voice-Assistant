{
  "manifest_version": 3,
  "name": "Orbit Browser Control",
  "version": "1.1.1",
  "description": "Trusted typed browser control for the local Orbit Voice Assistant.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.youtube.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Orbit Browser Control",
    "default_popup": "popup.html"
  }
}
